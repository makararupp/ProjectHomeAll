# Telegram Bot Configuration
# Get your token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# (Optional) Admin Telegram Chat ID or Group ID to receive new order alerts
# You can get your chat ID by messaging @userinfobot or @raw_data_bot on Telegram
ADMIN_CHAT_ID=

# Your HomeAll Front-End URL (for Telegram Mini App WebApp button)
# During local dev with Vite: http://localhost:5173 (or your ngrok / tunnel URL for HTTPS)
# In production: https://your-domain.com
MINI_APP_URL=http://localhost:5173

# Server Port
PORT=5000

# Bot Worker loop or polling options
POLLING_INTERVAL=300

# Store Location
STORE_LOCATION=Tolaka St, Krong Siem Reap 171201

